# ─────────────────────────────────────────────────────────────
# PRIVACY-CRITICAL — never commit personal data.
# This block exists before any data lands in the repo, by design.
# ─────────────────────────────────────────────────────────────
data/raw/                 # WhatsApp exports — raw, unscrubbed
data/derived/             # SFT pairs, name_map.json, neutralized drafts
data/*.db
data/*.sqlite*
*.jsonl
name_map.json
contacts.json
!data/raw/.gitkeep
!data/derived/.gitkeep
!tests/fixtures/*.jsonl   # synthetic fixtures ARE safe to commit

