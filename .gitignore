# Raw WhatsApp exports and everything derived from them. Never commit.
#
# The whole directory is excluded, with NO .gitkeep negation. That is
# deliberate: a `!data/raw/.gitkeep` exception forces git to descend into an
# excluded directory, and a trailing-slash pattern then fails to match the
# FILES inside it -- which is exactly how every WhatsApp export ended up
# untracked-but-addable earlier. No exception means no hole.
#
# The directories are created at runtime by the pipeline (mkdir parents=True),
# so nothing needs to hold their place in git.
data/
.secrets/

# Belt-and-braces: even if the paths above change, these never get committed.
*.jsonl
!tests/fixtures/*.jsonl
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
name_map.json
contacts.json
audit_sample*.txt
census.json
pairs*.jsonl
sft_pairs*.jsonl

# ───────────────────────── Secrets ─────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
*token.json
client_secret*.json
gcp-oauth*.json
service-account*.json

# ──────────────────── Models / weights ────────────────────
*.gguf
*.safetensors
*.bin
*.pth
*.ckpt
models/
outputs/
merged_fp16/
checkpoints/

# ───────────────────────── Python ─────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
htmlcov/
.coverage

# ─────────────────── Node / Next.js ───────────────────────
node_modules/
.next/
out/
.vercel/
*.tsbuildinfo

# ─────────────────── Editors / OS ─────────────────────────
.vscode/
.idea/
.qodo/
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Stray planning artifacts (canonical copy lives in docs/PLAN.md)
we-will-be-building-*.md
